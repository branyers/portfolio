---
import Layout from "@/layouts/Layout.astro"

import About from "@/components/sections/About.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import Strengths from "@/components/sections/Strengths.astro"
import Expertise from "@/components/sections/Expertise.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"

import { basics } from "@cv"
const { name, label } = basics
---

<Layout title={`Portafolio de ${name} - ${label}`}>
  <main>
    <Hero />
    <About />
    <Experience />
    <Education />
    <Projects />
    <Skills />
    <Strengths />
    <Expertise />
  </main>

  <KeyboardManager />
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }

  @media print {
    main {
      padding: 0;
      margin: 0;
      width: 100%;
    }

    /* Ensure proper page breaks */
    section {
      page-break-inside: avoid;
      margin-bottom: 2rem;
    }

    /* Hide interactive elements when printing */
    :global(button),
    :global(.no-print) {
      display: none !important;
    }

    /* Adjust colors for better printing */
    :global(body) {
      color: #000;
      background: #fff;
    }

    /* Ensure text is readable in print */
    :global(h1), :global(h2), :global(h3) {
      color: #000;
    }

    :global(a) {
      color: #000;
      text-decoration: underline;
    }
  }
</style>
